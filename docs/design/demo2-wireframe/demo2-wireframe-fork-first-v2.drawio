        <mxCell id="title" value="Demo2 产品演示主页 · Fork 强化版线稿 V2" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="980" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="全局定义长期存在；一次运行按时间顺序切换状态：专注工作做题 → 本轮检测与 Fork 选择 → 回流继续做题 → 工作流结算。" style="text;html=1;align=left;fontSize=15;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="home" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="900" height="1040" as="geometry"/></mxCell>
        <mxCell id="home-title" value="A · 事件主页 / 工作流运行入口" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="420" height="35" as="geometry"/></mxCell>
        <mxCell id="home-nav" value="ARK　&lt;b&gt;22408 考研&lt;/b&gt; · 161 天　　　　　　　　总览　学习系统　运行档案　设置" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="65" y="180" width="850" height="60" as="geometry"/></mxCell>
        <mxCell id="global" value="&lt;b&gt;事件 · 22408 考研&lt;/b&gt;　　距考试 161 天&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;事件是最高边界，以下学习模块、学习内容、运行档案与附加系统都归属于该事件。&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=17;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="65" y="265" width="850" height="750" as="geometry"/></mxCell>
        <mxCell id="event" value="&lt;b&gt;学习模块&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;每个学习模块由题库、专项训练和训练方案组成&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="90" y="365" width="800" height="195" as="geometry"/></mxCell>
        <mxCell id="en" value="&lt;b&gt;英语二&lt;/b&gt;&lt;br&gt;题库 3 · 专注工作 8 · 工作流 3&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;当前选中&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;spacing=12;fontSize=13;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="115" y="440" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="ma" value="&lt;b&gt;数学二&lt;/b&gt;&lt;br&gt;题库 2 · 专注工作 6 · 工作流 2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;spacing=12;fontSize=13;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="305" y="440" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="c408" value="&lt;b&gt;408&lt;/b&gt;&lt;br&gt;题库 4 · 专注工作 10 · 工作流 3" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;spacing=12;fontSize=13;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="495" y="440" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="po" value="&lt;b&gt;政治&lt;/b&gt;&lt;br&gt;题库 2 · 专注工作 5 · 工作流 2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;spacing=12;fontSize=13;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="685" y="440" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="global-note" value="&lt;b&gt;英语二 · 学习模块&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;先选择训练方案，再启动一次新的训练；Fork 预览随所选方案更新&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="90" y="585" width="800" height="350" as="geometry"/></mxCell>
        <mxCell id="workflow" value="&lt;b&gt;学习内容&lt;/b&gt;&lt;br&gt;&lt;br&gt;题库 3&lt;br&gt;2024 英语二真题&lt;br&gt;&lt;br&gt;专项训练 8&lt;br&gt;阅读理解&lt;br&gt;核心词汇&lt;br&gt;长难句 · 翻译" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fontSize=12;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="115" y="665" width="145" height="220" as="geometry"/></mxCell>
        <mxCell id="history" value="&lt;b&gt;选择训练方案　3 个&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;● 英语二阅读提升　已选&lt;/b&gt;&lt;/font&gt;&lt;br&gt;　阅读 → 翻译 → 复盘&lt;br&gt;　可 Fork 2 个补强分支&lt;br&gt;&lt;br&gt;○ 真题套卷模拟&lt;br&gt;　完形 → 阅读 → 翻译 → 写作&lt;br&gt;&lt;br&gt;○ 核心能力巩固&lt;br&gt;　词汇 → 长难句 → 翻译" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="275" y="665" width="225" height="220" as="geometry"/></mxCell>
        <mxCell id="wf-card" value="&lt;b&gt;ARK Fork 补强机制&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;未达标，不是简单重做：先补强，再回来验证。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;阅读理解　50% · 未达标&lt;/b&gt;&lt;br&gt;　　　　　↓ 定位句法薄弱&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;Fork：长难句补强　85% · 通过&lt;/b&gt;&lt;/font&gt;&lt;br&gt;　　　　　↓ 回流父专项训练&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;&lt;b&gt;阅读理解　100% · 重新验证通过&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="520" y="665" width="340" height="220" as="geometry"/></mxCell>
        <mxCell id="start" value="开始所选训练方案　→" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fontStyle=1;fillColor=#111827;strokeColor=#111827;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="275" y="890" width="225" height="40" as="geometry"/></mxCell>
        <mxCell id="hist1" value="&lt;b&gt;计划与激励&lt;/b&gt;　任务　·　日程　·　成就　　&lt;font color=&quot;#6B7280&quot;&gt;服务于事件与学习模块，不参与核心层级&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=13;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="90" y="950" width="800" height="48" as="geometry"/></mxCell>

        <mxCell id="focus" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="900" height="1040" as="geometry"/></mxCell>
        <mxCell id="focus-title" value="B · 运行中：全屏专注工作（只有做题）" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1010" y="135" width="500" height="35" as="geometry"/></mxCell>
        <mxCell id="focus-nav" value="&lt;b&gt;22408 考研 / 英语二 / 英语二阅读提升&lt;/b&gt;　　　　　　　　　运行 #4　00:13　暂停专注　放弃本阶段" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1015" y="180" width="850" height="60" as="geometry"/></mxCell>
        <mxCell id="focus-head" value="&lt;b&gt;阅读理解训练&lt;/b&gt;　　题目 1 / 2　　&lt;font color=&quot;#6B7280&quot;&gt;检测标准：正确率 ≥ 80%&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=14;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1015" y="260" width="850" height="55" as="geometry"/></mxCell>
        <mxCell id="material" value="&lt;b&gt;阅读材料&lt;/b&gt;&lt;br&gt;&lt;br&gt;In the quest for the perfect lawn, homeowners across the country are taking a shortcut—and it is the environment that is paying the price.&lt;br&gt;&lt;br&gt;About eight million square metres of plastic grass is sold each year but opposition has now spread to the highest gardening circles.&lt;br&gt;&lt;br&gt;The Royal Horticultural Society says it has introduced the ban because of the damage plastic grass does to the environment and biodiversity.&lt;br&gt;&lt;br&gt;The text continues as the complete reading material..." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1045" y="345" width="485" height="650" as="geometry"/></mxCell>
        <mxCell id="choices" value="&lt;b&gt;In Paragraph 4, supporters of fake grass point out _____.&lt;/b&gt;&lt;br&gt;&lt;br&gt;○ A　the necessity to lower the costs of fake grass&lt;br&gt;&lt;br&gt;○ B　the disadvantages of growing real grass&lt;br&gt;&lt;br&gt;○ C　the way to take care of artificial lawns&lt;br&gt;&lt;br&gt;○ D　the challenges of insect habitat protection" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1550" y="345" width="285" height="650" as="geometry"/></mxCell>
        <mxCell id="submit" value="提交答案" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fontStyle=1;fillColor=#111827;strokeColor=#111827;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1655" y="915" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="focus-note" value="&lt;b&gt;说明&lt;/b&gt;：左右区域均属于“选择型专注工作”的做题模板；页面不常驻工作流路径、运行档案或 Fork 图。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=13;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1045" y="1025" width="790" height="62" as="geometry"/></mxCell>

        <mxCell id="fork" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1940" y="120" width="900" height="1040" as="geometry"/></mxCell>
        <mxCell id="fork-title" value="C · 专注工作结束：检测结果与 Fork 选择" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1960" y="135" width="540" height="35" as="geometry"/></mxCell>
        <mxCell id="fork-nav" value="&lt;b&gt;22408 考研 / 英语二 / 英语二阅读提升&lt;/b&gt;　　　　　　　　　运行 #4　00:00" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1965" y="180" width="850" height="60" as="geometry"/></mxCell>
        <mxCell id="fork-bg" value="当前专注工作页面进入非交互背景状态" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=center;fontSize=15;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontColor=#9CA3AF;opacity=55;" vertex="1" parent="1"><mxGeometry x="1965" y="260" width="850" height="830" as="geometry"/></mxCell>
        <mxCell id="result-modal" value="&lt;b&gt;本轮专注已完成&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;检测结果　未通过　50%&lt;/b&gt;&lt;br&gt;已答 2　正确 1　正确率 50%　用时 5s&lt;br&gt;&lt;br&gt;&lt;b&gt;推荐继续练习&lt;/b&gt;&lt;br&gt;&lt;br&gt;▣ 不会单词？　核心词汇复习&lt;br&gt;&lt;br&gt;▣ 长难句看不懂？　长难句拆解&lt;br&gt;&lt;br&gt;▣ 针对训练　题型定位专项&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;选择一个 Fork 专注工作，完成后回流父专注工作重新验证。&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=24;fontSize=15;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="2155" y="340" width="470" height="590" as="geometry"/></mxCell>
        <mxCell id="retry" value="再来一轮" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="2220" y="850" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="enter-fork" value="启动 Fork 专注工作" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fontStyle=1;fillColor=#111827;strokeColor=#111827;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2390" y="850" width="190" height="48" as="geometry"/></mxCell>
        <mxCell id="fork-note" value="进入 Fork 后，界面重新切换为 B 的全屏做题状态；Fork 完成后再次出现检测结果，再决定继续 Fork 或回流父专注工作。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacing=16;fontSize=13;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="2050" y="980" width="680" height="78" as="geometry"/></mxCell>

        <mxCell id="settle" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2890" y="120" width="900" height="1040" as="geometry"/></mxCell>
        <mxCell id="settle-title" value="D · 整个工作流结束：运行档案与路径结算" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="2910" y="135" width="560" height="35" as="geometry"/></mxCell>
        <mxCell id="settle-nav" value="&lt;b&gt;22408 考研 / 英语二 / 英语二阅读提升&lt;/b&gt;　　　　　　　　　运行 #4 已完成" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fontSize=14;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="2915" y="180" width="850" height="60" as="geometry"/></mxCell>
        <mxCell id="settle-bg" value="事件主页作为弱化背景" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=center;fontSize=15;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontColor=#9CA3AF;opacity=55;" vertex="1" parent="1"><mxGeometry x="2915" y="260" width="850" height="830" as="geometry"/></mxCell>
        <mxCell id="settlement" value="&lt;b&gt;工作流完成&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;本次工作流的专注工作路径已结束&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;总专注时间 12 分钟　　完成专注工作 5　　Fork 1 次　　最佳正确率 100%&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;本次实际学习路径&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 阅读理解训练　50% · 未通过&lt;br&gt;　└─ ② Fork：长难句拆解　85% · 通过&lt;br&gt;　　　└─ ③ 回流阅读理解训练　100% · 通过&lt;br&gt;　　　　　④ 翻译训练 · 通过&lt;br&gt;　　　　　⑤ 复盘 · 完成&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;该路径保存为工作流运行 #4，下一次运行重新从工作流定义启动。&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=24;fontSize=15;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="3070" y="320" width="540" height="650" as="geometry"/></mxCell>
        <mxCell id="back" value="返回事件主页" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="3140" y="890" width="170" height="48" as="geometry"/></mxCell>
        <mxCell id="again" value="再次运行同一工作流" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=14;fontStyle=1;fillColor=#111827;strokeColor=#111827;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3330" y="890" width="215" height="48" as="geometry"/></mxCell>

        <mxCell id="flow1" value="启动运行 #4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="focus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="894"/><mxPoint x="960" y="640"/></Array></mxGeometry></mxCell>
        <mxCell id="flow2" value="本轮提交并检测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="focus" target="fork"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow3" value="工作流所有阶段完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fork" target="settle"><mxGeometry relative="1" as="geometry"/></mxCell>
