# Copy to deploy/.env on the server and replace every placeholder before startup.
POSTGRES_DB=ark
POSTGRES_USER=ark
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ark:replace-with-a-url-encoded-password@db:5432/ark

# Existing certificate files on the server. These must be readable by Docker.
TLS_CERT_PATH=/etc/nginx/ssl/strangetalking.xin_bundle.crt
TLS_KEY_PATH=/etc/nginx/ssl/strangetalking.xin.key

# Backend application settings.
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_PASSWORD_ITERATIONS=210000
AUTH_EMAIL_TOKEN_TTL_SECONDS=1800
AUTH_EMAIL_DELIVERY_MODE=disabled
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=ark@strangetalking.xin
TENCENT_SES_VERIFY_TEMPLATE_ID=
TENCENT_SES_RESET_TEMPLATE_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_TIMEOUT_SECONDS=45
